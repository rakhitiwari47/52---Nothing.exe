# HealFlow AI Backend Configuration

# Application
APP_NAME=HealFlow AI
APP_ENV=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Database
# For local dev fallback, leave empty or use sqlite:///./healflow.db
# For production PostgreSQL (Render/Neon/Supabase): postgresql://user:password@host:port/dbname
DATABASE_URL=sqlite:///./healflow.db

# AI Provider Configuration
# Set to 'gemini', 'openai', or leave blank for deterministic FALLBACK_RULES engine
AI_PROVIDER=gemini
GEMINI_API_KEY=
# OPENAI_API_KEY=

# Safety & Recovery Limits
MAX_RECOVERY_RETRIES=3
RECOVERY_TIMEOUT_SECONDS=10
DEMO_MODE=true
